%% Rest API Client
	class RestApiClient {
		<<abstract>>
		+get<ReturnData>(url: string, query?): Promise<ReturnData>
		+post<PostData, ReturnData>(url: string, data: PostData, query?): Promise<ReturnData>
		+patch<PatchData, ReturnData>(url: string, data: PatchData, query?): Promise<ReturnData>
		+put<PutData, ReturnData>(url: string, data: PutData, query?): Promise<ReturnData>
		+delete<ReturnData>(url: string, query?): Promise<ReturnData>
	}
	class AxiosClient {
		-baseUrl: string
		-headers: Record<string,string>
		-refreshUrl: string
		+constructor(baseUrl: string, headers: Record<string,string>, refreshUrl: string)
	}
	RestApiClient <|-- AxiosClient

%% Auth Service
	class IAuthService {
		<<abstract>>
		+login(userData: LoginRequest): Promise<LoginResponse>
		+register(userData: RegisterRequest): Promise<RegisterResponse>
		+logout(): Promise<void>
		+refresh(): Promise<LoginResponse>
		+me(): Promise<User>
	}
	class AuthService {
		-client: RestApiClient
		+constructor(client: RestApiClient)
		+login(...)
		+register(...)
		+logout()
		+refresh()
		+me()
	}
	IAuthService <|-- AuthService
	AuthService o-- RestApiClient : uses

