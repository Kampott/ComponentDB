		+setAuth(isAuthenticated: boolean): void
		+login(userData: LoginRequest): Promise<void>
		+logout(): Promise<void>
		+checkAuth(): Promise<void>
	}
	class useStore {
		+store: IServicesStore
	}
	useStore ..> IServicesStore : returns
	IServicesStore o-- Services : stores
