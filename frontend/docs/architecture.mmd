%% Aggregator Services
	class Services {
		+restApiClient: RestApiClient
		+authService: IAuthService
		+instancesPropertiesService: IInstancesPropertiesService
		+objectService: IObjectsService
		+objectsInstancesService: IObjectsInstancesService
		+objectsTypesService: IObjectsTypesService
		+propertiesService: IPropertiesService
		+propertiesTypesService: IPropertiesTypesService
		+constructor()
	}
	Services o-- RestApiClient
	Services o-- AuthService
	Services o-- InstancesPropertiesService
	Services o-- ObjectsService
	Services o-- ObjectsInstancesService
	Services o-- ObjectsTypesService
	Services o-- PropertiesService
	Services o-- PropertiesTypesService

%% Store
	class IServicesStore {
		+services: Services
		+user: User
		+isAuthenticated: boolean
