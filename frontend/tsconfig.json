{
    "files": [],
    "references": [
        { "path": "./tsconfig.app.json" },
        { "path": "./tsconfig.node.json" }
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@EntityDsl": ["src/EntityDsl/index.ts"],
            "@EntityDsl/*": ["src/EntityDsl/*"],
            "@EntityDsl/Core": ["src/EntityDsl/Core/index.ts"],
            "@EntityDsl/Ui": ["src/EntityDsl/Ui/index.ts"],
            "@EntityUi": ["src/React/EntityUi/index.ts"],
            "@EntityUi/*": ["src/React/EntityUi/*"],
            "@Kernel/*": ["src/Kernel/*"],
            "@React/*": ["src/React/*"],
            "@Components/*": ["src/React/Components/*"],
            "@Rest/*": ["src/Rest/*"],
            "@Schemas": ["src/Kernel/Schemas/index.ts"],
            "@Storage/*": ["src/Interfaces/Storage/*"],
            "@Storage": ["src/Interfaces/Storage/index.ts"],
            "@StorageImpl": ["src/Kernel/Storage/Zustand/index.ts"]
        }
    }
}
